# Java
target/
*.jar

# Maven
.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
.vscode/

# Python
.venv/
venv/
__pycache__/
*.pyc

# Node
node_modules/

# TypeScript incremental build cache — a build artifact, never a build input.
# Was tracked until now, so every local `tsc -b` showed up as a spurious diff.
*.tsbuildinfo

# Logs
*.log

# Playwright MCP's own output dir (screenshots/accessibility snapshots from interactive/dev
# sessions) — disposable runtime artifacts, never a build input, same reasoning as *.log above.
.playwright-mcp/

# Playwright Test's own run artifacts (frontend/playwright.config.ts) — HTML report + traces/
# screenshots from failed runs, regenerated by every `npm run test:e2e`, never a build input.
frontend/playwright-report/
frontend/test-results/

.env
.env.*
careerpilot.env

# Built by the frontend Dockerfile's own `npm run build` stage now — never a
# build input, and committing it was the exact root cause of a real bug
# (stale VITE_API_BASE_URL baked into a checked-in bundle, silently ignored
# by every later Docker build). See frontend/Dockerfile.
frontend/dist