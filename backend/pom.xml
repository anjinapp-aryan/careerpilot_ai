<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>ai.careerpilot</groupId>
    <artifactId>careerpilot-backend</artifactId>
    <version>0.1.0</version>
    <name>careerpilot-backend</name>

    <properties>
        <java.version>25</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <aws.sdk.version>2.28.29</aws.sdk.version>
        <springdoc.version>3.0.3</springdoc.version>
        <!-- Phase 9.1 — Spring AI Foundation. Version pinned to the Spring Boot 4-line
             GA release (spring-ai-bom 2.0.0 is the first Spring AI major aligned with
             Boot 4, mirroring how 1.x tracked Boot 3.x). -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <!-- P7 Action 1 — overrides spring-boot-dependencies:4.0.7's own testcontainers.version
             (2.0.5). Verified against Maven Central directly: org.testcontainers:testcontainers
             (core) has released 2.0.x, but org.testcontainers:junit-jupiter and :postgresql have
             not — their latest published version is 1.21.4. Pinning the whole family to 1.21.4
             here (a property override child POMs can apply to values used inside an inherited
             parent BOM import) keeps every testcontainers artifact this project pulls in on one
             consistent, fully-released line, rather than mixing an unreleased-module 2.0.5 with a
             released-module 1.21.4. -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Phase 9.1 — Spring AI Foundation. BOM only; nothing in ai.careerpilot.ai
                 (the existing AI Gateway / Smart Router / providers) depends on Spring AI
                 or is affected by this import — see ai.careerpilot.ai.springai package. -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-redis</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webflux</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-aspectj</artifactId></dependency>

        <!-- Phase 9.1 — Spring AI Foundation (dependencies only). Provides ChatModel /
             StreamingChatModel / EmbeddingModel abstractions used solely by
             ai.careerpilot.ai.springai — NOT wired into AiGatewayService, the Smart
             Router, or any business service. OpenAI-compatible starter chosen because
             it's the one protocol every existing provider already speaks (NVIDIA NIM,
             Groq, OpenRouter, SambaNova are all OpenAI-compatible — see
             AbstractOpenAiChatProvider); this does not mean Spring AI calls those
             providers today, only that the same wire protocol is available if/when a
             future phase wires it in. -->
        <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-starter-model-openai</artifactId></dependency>
        <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-starter-model-google-genai</artifactId></dependency>
        <!-- The starter above pulls only openai-java-core (request/response models +
             the OpenAIClient interface); it does NOT pull an HTTP transport
             implementation. openai-java-client-okhttp is that transport — needed to
             actually construct an OpenAIClient in SpringAiConfig. Version pinned to
             match openai-java-core's version (4.39.1, brought in transitively by
             spring-ai-bom) since the two must stay in lockstep. -->
        <dependency><groupId>com.openai</groupId><artifactId>openai-java-client-okhttp</artifactId><version>4.39.1</version></dependency>

        <!-- AI Gateway resilience: retry, timeout, circuit breaker -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>2.4.0</version>
        </dependency>

        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
        <!-- Boot 4 split spring-boot-autoconfigure into per-tech modules:
             flyway-core alone no longer wires FlywayAutoConfiguration/FlywayMigrationInitializer,
             so migrations silently never ran without this. -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-flyway</artifactId></dependency>

        <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-api</artifactId><version>${jjwt.version}</version></dependency>
        <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-impl</artifactId><version>${jjwt.version}</version><scope>runtime</scope></dependency>
        <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-jackson</artifactId><version>${jjwt.version}</version><scope>runtime</scope></dependency>

        <dependency><groupId>software.amazon.awssdk</groupId><artifactId>s3</artifactId><version>${aws.sdk.version}</version></dependency>

        <!-- Gap D — real browser automation for the guest/no-login apply flow (execution.browser).
             Headless Chromium only; no credentialed login is ever performed (see
             ai.careerpilot.execution.browser.PlaywrightAutomationProvider javadoc). -->
        <dependency><groupId>com.microsoft.playwright</groupId><artifactId>playwright</artifactId><version>1.48.0</version></dependency>

        <dependency><groupId>org.apache.tika</groupId><artifactId>tika-core</artifactId><version>2.9.2</version></dependency>
        <dependency><groupId>org.apache.tika</groupId><artifactId>tika-parsers-standard-package</artifactId><version>2.9.2</version></dependency>

        <!-- DOCX generation for optimized resume export (Resume Optimization, Stage 1) -->
        <dependency><groupId>org.apache.poi</groupId><artifactId>poi-ooxml</artifactId><version>5.3.0</version></dependency>
        <!-- POI 5.3.0 needs commons-io >= 2.16 (BoundedInputStream.builder); Tika pins an
             older one, so align it explicitly to avoid a NoSuchMethodError at runtime. -->
        <dependency><groupId>commons-io</groupId><artifactId>commons-io</artifactId><version>2.18.0</version></dependency>

        <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-ui</artifactId><version>${springdoc.version}</version></dependency>

        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><optional>true</optional></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-configuration-processor</artifactId><optional>true</optional></dependency>
        <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId></dependency>

        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>

        <!-- P7 Action 1 — real-Postgres concurrency proof for ApplicationExecutionRepository#claimForSubmit.
             Versions come from Spring Boot 4.0.7's own dependency management (spring-boot-testcontainers +
             the testcontainers-bom), so nothing here is separately version-pinned. Test scope only — no
             production code or runtime dependency is affected. -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-testcontainers</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
        <!-- Boot 4 split spring-boot-test-autoconfigure into per-tech modules too (same pattern
             CLAUDE.md documents for the Kafka/Flyway starters) — @DataJpaTest/@AutoConfigureTestDatabase
             moved out of the core jar into this one. -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-data-jpa-test</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JDK 23+ disables implicit annotation processing from the classpath (JDK-8306819),
                 which stops Lombok from running. Declaring it on an explicit processor path
                 re-enables it. ${lombok.version} (1.18.46, JDK 25-capable) is managed by the
                 Spring Boot 4 parent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId></exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
