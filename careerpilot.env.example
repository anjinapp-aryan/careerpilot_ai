# =============================================================================
# CareerPilot AI — canonical production environment file (Oracle Linux 9)
# =============================================================================
# TEMPLATE ONLY. Copy this to /etc/careerpilot/careerpilot.env on the VM and
# fill in real values there — never commit the filled-in file (it's gitignored
# by design; this .example file is the only version that belongs in git).
#
# This is the SAME file docker-compose.yml's `backend` and `agent-service`
# services load in full via `env_file:` — every variable here reaches those
# containers' actual process environment under the exact name shown (no
# separate compose-substitution renaming layer: MINIO_*/SPRING_DATASOURCE_*/
# REDIS_URL are the canonical, app-facing names, matching what application.yml /
# agent-service/app/config.py actually read). The only exception is the `minio`
# service itself, which needs MINIO_ROOT_USER/MINIO_ROOT_PASSWORD — that rename
# is handled entirely inside docker-compose.yml (sourced from MINIO_ACCESS_KEY/
# MINIO_SECRET_KEY below), nothing to duplicate here.
#
# Location on the VM: /etc/careerpilot/careerpilot.env, permissions locked down
# (chmod 600, chown root:root — see deployment/setup-env.sh). docker-compose.yml's
# `env_file: .env` is a path relative to /opt/careerpilot (the repo checkout) —
# keep /opt/careerpilot/.env symlinked to this file so there is exactly one real
# file:
#   ln -sfn /etc/careerpilot/careerpilot.env /opt/careerpilot/.env
# See DEPLOYMENT_ORACLE_CLOUD.md and deployment/README.md for the full setup
# sequence.
# =============================================================================


# =============================================================================
# 1. CORE SECRETS — REQUIRED, app refuses to start or is insecure without these
# =============================================================================

# HMAC signing key for JWT access tokens. Must be >= 32 chars — JwtService.init()
# throws and the app FAILS TO BOOT if this is missing or too short. Generate with:
#   openssl rand -hex 48
JWT_SECRET=REPLACE_ME

# Primary LLM key (Google Gemini). Required if AI_PROVIDER=gemini or if gemini
# appears anywhere in AI_PROVIDER_ORDER (it does by default). Without it, every
# AI Gateway call to Gemini fails over to the next configured provider — if NO
# provider is configured, all AI-backed features (copilot, resume tailoring,
# ATS optimization, cover letters, career strategy, etc.) return errors.
GEMINI_API_KEY=REPLACE_ME


# =============================================================================
# 2. DATABASE (Neon serverless Postgres or any Postgres 14+ with pgvector)
# =============================================================================

# REQUIRED. Full JDBC connection string. Flyway runs migrations against this on
# boot — app fails to start if unreachable or if the pgvector extension is
# missing. Neon users: use the DIRECT endpoint (no "-pooler" in the hostname —
# Flyway DDL + prepared statements break under Neon's transaction-mode pgBouncer).
# Credentials can be embedded as query params (works with Neon):
#   jdbc:postgresql://HOST/DB?sslmode=require&channelBinding=require&user=U&password=P
DATABASE_URL=REPLACE_ME

# OPTIONAL. Only needed if you'd rather keep credentials out of DATABASE_URL's
# query string instead of embedding them (see comment above). Leave blank if
# DATABASE_URL already carries user/password.
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# REQUIRED if the agent-service container is part of this stack (it is, per the
# finalized architecture). Same Neon DB as DATABASE_URL above, libpq connection-
# string form (agent-service/app/config.py's Settings.database_url reads this
# exact name via validation_alias="DATABASE_URL_PY"). Without it, LangGraph's
# PostgresSaver checkpoint table can't connect and every workflow run fails.
DATABASE_URL_PY=REPLACE_ME

# OPTIONAL — HikariCP pool sizing. Defaults are fine for a single small VM;
# raise DB_POOL_MAX if you see connection-pool exhaustion under load.
DB_POOL_MAX=10
DB_POOL_MIN=2

# OPTIONAL — HikariCP connection lifecycle tuning. Neon can recycle/suspend
# idle connections server-side; max-lifetime keeps our pool retiring
# connections before Neon does it for us. Leak detection is off (0) by
# default — set DB_LEAK_DETECTION_MS=60000 only while debugging a suspected
# connection leak (it adds per-checkout overhead).
DB_CONNECTION_TIMEOUT_MS=30000
DB_MAX_LIFETIME_MS=1500000
DB_LEAK_DETECTION_MS=0

# OPTIONAL — graceful shutdown ceiling (server.shutdown=graceful is always on).
# How long Tomcat waits for in-flight requests to finish on SIGTERM before the
# JVM force-exits. Keep this above AGENT_SERVICE read-timeout (120s default,
# section 6) if you routinely see long-running workflow calls in flight.
SHUTDOWN_TIMEOUT=45s

# OPTIONAL — thread pool for @Scheduled jobs (job discovery, retention,
# candidate-profile rebuild, company discovery, autopilot, career
# orchestrator...). Spring Boot's default is a single shared thread; raise
# this before enabling more than one cron-driven feature flag at once, or one
# long-running job can silently starve the others.
TASK_SCHEDULER_POOL_SIZE=4


# =============================================================================
# 3. REDIS — OPTIONAL (only required if you enable any *_CACHE_ENABLED flag
#    in section 8, e.g. JOB_MATCH_CACHE_ENABLED, RESUME_TAILORING_CACHE_ENABLED).
#    Without Redis, those caches simply can't be turned on; everything else
#    works fine with the default (unreachable) localhost value below since the
#    app never opens the connection unless a cache path is exercised.
# =============================================================================

# Single connection-string form: redis://[:password@]host:port, or
# rediss://... for TLS (most managed Redis services, e.g. Oracle's own
# Cache/OCI-hosted Redis, require TLS — use rediss://). `redis` is the Docker
# Compose service name — resolves via Docker's embedded DNS on the shared
# compose network, not localhost (the backend container's own loopback would
# not reach the separate redis container).
REDIS_URL=redis://redis:6379


# =============================================================================
# 4. KAFKA — OPTIONAL. The producer bean is created at boot regardless (Spring
#    Boot autoconfiguration), but connects lazily on first publish. If you have
#    no Kafka broker, the app still boots fine; KAFKA_ENABLED gates whether
#    WorkflowEventProducer actually publishes (nothing currently consumes these
#    events — CLAUDE.md confirms zero @KafkaListener beans exist — so it is
#    safe to leave this disabled for a single-VM Oracle Linux deploy).
# =============================================================================

# `kafka` = the Compose service name, port 29092 = the PLAINTEXT internal listener
# (see docker-compose.yml's KAFKA_ADVERTISED_LISTENERS) — not the same as the 9092
# host-facing listener, which isn't published to the host in this hardened stack.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_ENABLED=false
KAFKA_PRODUCER_BUFFER_MEMORY=1048576


# =============================================================================
# 5. OBJECT STORAGE (S3-compatible) — REQUIRED for resume upload, cover-letter
#    export, and application-package file storage (core Phase-1 features, not
#    a dark flag). Point this at Oracle Object Storage's S3-compatible API
#    endpoint, AWS S3, or a self-hosted MinIO — any S3-compatible target works.
# =============================================================================

# `minio` = the Compose service name (docker-compose.yml's `minio:` service),
# resolves via Docker's embedded DNS on the shared compose network.
MINIO_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
MINIO_BUCKET=careerpilot
MINIO_ACCESS_KEY=REPLACE_ME
MINIO_SECRET_KEY=REPLACE_ME


# =============================================================================
# 6. AGENT SERVICE — REQUIRED if you run the LangGraph workflow (resume
#    intelligence -> job discovery -> ... -> application tracking). If you are
#    deploying ONLY the Spring Boot backend on this Oracle Linux instance and
#    the Python agent-service lives elsewhere (or isn't deployed at all),
#    point this at its real reachable URL — the default localhost:8088 will
#    NOT work once the backend is off your dev machine, and every
#    POST /api/workflows/run call will fail.
# =============================================================================

AGENT_SERVICE_URL=http://agent-service:8088


# =============================================================================
# 7. AI GATEWAY — multi-provider LLM routing with automatic failover
#    (AiGatewayService). GEMINI_API_KEY (section 1) covers the default chain;
#    everything below is OPTIONAL — each provider is skipped automatically
#    when its key is blank (AbstractLlmProvider#isConfigured()).
# =============================================================================

AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Failover order and which provider is reported as "primary" in diagnostics/
# health endpoints. Provider names not configured below are silently skipped.
PRIMARY_PROVIDER=deepseek
AI_PROVIDER_ORDER=deepseek,gemini,groq,qwen,openrouter
AI_SMART_ROUTER_ENABLED=false

# NVIDIA NIM-hosted DeepSeek (OpenAI-compatible). Leave blank to skip.
DEEP_SHEEK_NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-flash

# NVIDIA NIM-hosted Qwen (OpenAI-compatible). Leave blank to skip.
QWEN3_NVIDIA_API_KEY=
NVIDIA_QWEN_MODEL=qwen/qwen3-next-80b-a3b-instruct

# Groq-hosted Llama 3.3 70B (OpenAI-compatible). Leave blank to skip.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (unified API, free + paid models). Leave blank to skip.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
# OPENROUTER_TEMPERATURE / OPENROUTER_MAX_TOKENS intentionally NOT set here —
# AiGatewayProperties.Provider has no temperature/maxTokens field, so these
# two vars are dead regardless of value (kept for reference only, unused).

# pgvector semantic embeddings (Gemini text-embedding-004). Optional — off by
# default; enabling requires the `embedding vector(768)` columns (already in
# the schema) and, ideally, an HNSW/IVFFlat index (not created by any migration).
EMBEDDINGS_ENABLED=false
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_DIMENSIONS=768
EMBEDDINGS_MAX_CHARS=8000
EMBEDDINGS_MAX_PER_RUN=200


# =============================================================================
# 8. HTTP / SERVER TUNING — OPTIONAL, sane defaults for a small VM
# =============================================================================

# PORT intentionally NOT set. The backend defaults to 8080 (server.port:
# ${PORT:8080}) without it, and the agent-service's Dockerfile CMD also honors
# PORT — a shared PORT=8080 here leaks into the agent container via env_file
# and rebinds uvicorn from 8088 to 8080, breaking its healthcheck and the
# backend's AGENT_SERVICE_URL. docker-compose.yml pins PORT=8088 on the
# agent-service anyway, but keep this unset regardless.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
TOMCAT_THREADS_MAX=20
TOMCAT_THREADS_MIN_SPARE=4
TOMCAT_ACCEPT_COUNT=20
TOMCAT_MAX_CONNECTIONS=100

# Frontend build arg (docker-compose.yml's `frontend.build.args`) — only
# relevant if this VM also builds/serves its own frontend container
# alongside Vercel. Baked into the static JS bundle at `docker compose build`
# time (frontend/src/lib/api.ts's axios baseURL) — changing this value
# requires a rebuild, not just a restart. "/api" is a same-origin relative
# path: it only works once Nginx is proxying /api/* to the backend — until
# then, hitting this VM's frontend directly on :5173 will have broken API
# calls, since nothing on :5173 itself serves /api. Leave blank/unset if this
# VM never builds its own frontend (Vercel-only setups, the common case).
VITE_API_BASE_URL=/api


# =============================================================================
# 9. FEATURE FLAGS — ALL OPTIONAL. Every flag below defaults to what's shown;
#    every feature ships DARK (disabled) unless explicitly noted otherwise.
#    Flip individual flags on only after reading the corresponding section of
#    CLAUDE.md — most have a companion "*_TRIGGER_ENABLED" flag that must
#    ALSO be set to actually chain off the prior pipeline stage.
# =============================================================================

# ---- Phase 1: Candidate Intelligence Profile ----
CANDIDATE_PROFILE_ENABLED=false
CANDIDATE_PROFILE_MAX_RESUME_CHARS=12000
CANDIDATE_PROFILE_BACKFILL_THROTTLE_MS=500
CANDIDATE_PROFILE_REBUILD_ENABLED=false
CANDIDATE_PROFILE_REBUILD_CRON=0 0 2 ? * SUN
CANDIDATE_PROFILE_REBUILD_MAX_PER_RUN=200
PROFILE_SINGLE_SOURCE_ENABLED=false
CANDIDATE_RECOMMENDATION_AUDIT_ENABLED=false

# ---- Phase 2 Job Discovery: engine + matching ----
JOB_ENRICH_ENABLED=true
JOBS_ENRICH_AI_ENABLED=false
JOBS_ENRICH_AI_MAX_PER_RUN=200
JOBS_ENRICH_AI_MAX_CHARS=6000
JOBS_ENRICH_AI_PROVIDERS=gemini
JOBS_DEDUP_ENABLED=false
JOBS_DEDUP_MAX_PER_RUN=200
JOBS_DEDUP_EMBEDDING_THRESHOLD=0.92
JOBS_DEDUP_TITLE_JACCARD_THRESHOLD=0.55
JOB_INDUSTRY_FILTER=true
JOBS_MATCHING_PROFILE_SOURCE_ENABLED=false
JOBS_MATCHING_USE_ENRICHMENT=false
JOBS_MATCHING_ROLE_RELEVANCE_MIN=10
JOBS_MATCHING_SKILL_DENOM_CAP=8
JOB_HARD_PREFERENCE_ENABLED=false
JOB_MATCH_CACHE_ENABLED=false
JOB_RECO_V2_ENABLED=true
JOB_RECO_THRESHOLD=70
JOB_RECO_STRICT_GATE=true
JOB_RECO_GATE_MIN_SCORE=70
JOB_RECO_GATE_MIN_SKILLS=3
JOB_AUTO_CATEGORIZATION_ENABLED=false
RECOMMENDATION_PRIORITY_ENABLED=false
JOB_EXPLAIN_ENABLED=true
JOB_RELEVANCE_JAVA_BACKEND_TITLES=
JOB_RELEVANCE_DATA_ENGINEERING_TITLES=
JOB_RELEVANCE_DEVOPS_TITLES=
JOB_RELEVANCE_FRONTEND_TITLES=
JOB_RELEVANCE_EXCLUDED_DOMAINS=

# ---- Job discovery scheduler + keyless/keyed providers ----
JOB_DISCOVERY_ENABLED=true
JOBS_DISCOVERY_SCOPE_STRICT_ENABLED=false
JOB_DISCOVERY_CRON=0 0 6 * * *
JOB_DISCOVERY_HOURLY_ENABLED=false
JOB_DISCOVERY_HOURLY_CRON=0 0 * * * *
JOB_DISCOVERY_USER_AGENT=CareerPilotAI/1.0 (+https://careerpilot.ai)
REMOTEOK_BASE_URL=https://remoteok.com
ARBEITNOW_BASE_URL=https://www.arbeitnow.com
# Adzuna: keyed provider, skipped automatically if APP_ID/APP_KEY blank.
ADZUNA_BASE_URL=https://api.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=in,us,gb,de,fr,nl
ADZUNA_RESULTS_PER_PAGE=50
# Jooble: keyed provider, skipped automatically if API_KEY blank.
JOOBLE_BASE_URL=https://jooble.org
JOOBLE_API_KEY=
JOOBLE_KEYWORDS=software engineer,data engineer

# ---- Phase 2A Job Lake (shadow discovery pipeline, additive, dark) ----
JOB_LAKE_DISCOVERY_ENABLED=false
JOB_LAKE_DISCOVERY_CRON=0 0 2 * * *
JOB_DISCOVERY_DEDUP_ENABLED=false
JOB_LAKE_DEDUP_TITLE_THRESHOLD=0.6
JOB_SOFTWARE_FILTER_ENABLED=false

# ---- Phase 2C Recommendation Intelligence (human approval + feedback) ----
RECOMMENDATION_APPROVAL_ENABLED=false
RECOMMENDATION_FEEDBACK_ENABLED=false

# ---- Phase 2D.1 Resume Tailoring Engine ----
RESUME_SELECTION_ENABLED=false
RESUME_SELECTION_ATS_FLOOR=70
RESUME_AUTOPILOT_ENABLED=false
RESUME_TAILORING_ENABLED=false
RESUME_TAILORING_CACHE_ENABLED=false
RESUME_TAILORING_TRIGGER_ON_APPROVE_ENABLED=false
RESUME_TAILORING_MIN_LENGTH=800
RESUME_TAILORING_MAX_LENGTH=20000
RESUME_TAILORING_EXECUTOR_CORE_POOL_SIZE=2
RESUME_TAILORING_EXECUTOR_MAX_POOL_SIZE=5
RESUME_TAILORING_EXECUTOR_QUEUE_CAPACITY=50
RESUME_TAILORING_PREFERRED_PROVIDERS=gemini,groq,deepseek,qwen,openrouter

# ---- Phase 2D.2 ATS Optimization Engine ----
ATS_OPTIMIZATION_ENABLED=false
ATS_OPTIMIZATION_TRIGGER_ON_TAILORING_ENABLED=false
ATS_OPTIMIZATION_EXECUTOR_CORE_POOL_SIZE=2
ATS_OPTIMIZATION_EXECUTOR_MAX_POOL_SIZE=5
ATS_OPTIMIZATION_EXECUTOR_QUEUE_CAPACITY=50

# ---- Phase 2D.3 Gap Analysis Engine (deterministic, non-LLM) ----
GAP_ANALYSIS_ENABLED=false
GAP_ANALYSIS_TRIGGER_ENABLED=false
GAP_ANALYSIS_CACHE_ENABLED=true
GAP_ANALYSIS_EXECUTOR_CORE_POOL_SIZE=2
GAP_ANALYSIS_EXECUTOR_MAX_POOL_SIZE=4
GAP_ANALYSIS_EXECUTOR_QUEUE_CAPACITY=100

# ---- Phase 2D.4 ATS Explainability Engine (deterministic, non-LLM) ----
ATS_EXPLAINABILITY_ENABLED=false
ATS_EXPLAINABILITY_TRIGGER_ENABLED=false
ATS_EXPLAINABILITY_EXECUTOR_CORE_POOL_SIZE=2
ATS_EXPLAINABILITY_EXECUTOR_MAX_POOL_SIZE=4
ATS_EXPLAINABILITY_EXECUTOR_QUEUE_CAPACITY=100

# ---- Phase 2D.5 Cover Letter Engine (LLM-backed) ----
COVER_LETTER_ENABLED=false
COVER_LETTER_TRIGGER_ENABLED=false
COVER_LETTER_CACHE_ENABLED=true
COVER_LETTER_MIN_LENGTH=300
COVER_LETTER_MAX_LENGTH=6000
COVER_LETTER_EXECUTOR_CORE_POOL_SIZE=2
COVER_LETTER_EXECUTOR_MAX_POOL_SIZE=5
COVER_LETTER_EXECUTOR_QUEUE_CAPACITY=50

# ---- Phase 2D.6 Application Package Builder ----
APPLICATION_PACKAGE_ENABLED=false
APPLICATION_PACKAGE_TRIGGER_ENABLED=false
APPLICATION_PACKAGE_CACHE_ENABLED=true
APPLICATION_PACKAGE_EXECUTOR_CORE_POOL_SIZE=2
APPLICATION_PACKAGE_EXECUTOR_MAX_POOL_SIZE=4
APPLICATION_PACKAGE_EXECUTOR_QUEUE_CAPACITY=100
APPLICATION_PACKAGE_VALIDATION_ENABLED=false
APPLICATION_PACKAGE_VALIDATION_TRIGGER_ENABLED=false
APPLICATION_PACKAGE_VALIDATION_REQUIRE_LEARNING=false
APPLICATION_PACKAGE_VALIDATION_EXECUTOR_CORE_POOL_SIZE=2
APPLICATION_PACKAGE_VALIDATION_EXECUTOR_MAX_POOL_SIZE=4
APPLICATION_PACKAGE_VALIDATION_EXECUTOR_QUEUE_CAPACITY=200
APPLICATION_PACKAGE_HISTORY_ENABLED=false
APPLICATION_PACKAGE_DIAGNOSTICS_ENABLED=false

# ---- AI Review + Company Knowledge (feeds the submission pipeline's Review/Company stages) ----
APPLICATION_REVIEW_ENABLED=false
APPLICATION_REVIEW_TRIGGER_ENABLED=false
APPLICATION_REVIEW_RESUME_ENABLED=false
APPLICATION_REVIEW_ATS_ENABLED=false
APPLICATION_REVIEW_COMPANY_ENABLED=false
APPLICATION_REVIEW_LEARNING_ENABLED=false
APPLICATION_REVIEW_CONSISTENCY_ENABLED=false
APPLICATION_REVIEW_QUALITY_ENABLED=false
APPLICATION_REVIEW_DIAGNOSTICS_ENABLED=false
APPLICATION_REVIEW_EXECUTOR_CORE_POOL_SIZE=2
APPLICATION_REVIEW_EXECUTOR_MAX_POOL_SIZE=4
APPLICATION_REVIEW_EXECUTOR_QUEUE_CAPACITY=200

# ---- Application decision engine (auto-apply/review/save thresholds) ----
APPLICATION_DECISION_ENABLED=false
APPLICATION_DECISION_AUTO_APPLY_MIN_SCORE=90
APPLICATION_DECISION_REVIEW_MIN_SCORE=75
APPLICATION_DECISION_SAVE_MIN_SCORE=60
APPLICATION_DECISION_ATS_FLOOR=70
APPLICATION_DECISION_FAILURE_PENALTY_CAP=-20
APPLICATION_AUTO_ENABLED=false

# ---- Phase 2D.7 Auto Apply Package Preparation (prep only, no automation) ----
AUTO_APPLY_PACKAGE_ENABLED=false
AUTO_APPLY_TRIGGER_ENABLED=false
AUTO_APPLY_EXECUTOR_CORE_POOL_SIZE=2
AUTO_APPLY_EXECUTOR_MAX_POOL_SIZE=4
AUTO_APPLY_EXECUTOR_QUEUE_CAPACITY=100

# ---- Phase 2E Enterprise Auto-Apply Execution Engine (HIGH RISK — read
#      CLAUDE.md's Real Browser Automation section before enabling ANY of these) ----
APPLICATION_EXECUTION_ENABLED=false
APPLICATION_EXECUTION_TRIGGER_ENABLED=false
APPLICATION_EXECUTION_EXECUTOR_CORE_POOL_SIZE=2
APPLICATION_EXECUTION_EXECUTOR_MAX_POOL_SIZE=4
APPLICATION_EXECUTION_EXECUTOR_QUEUE_CAPACITY=50
APPLICATION_APPROVAL_ENABLED=true
APPLICATION_SAFETY_ENABLED=true
APPLICATION_SAFETY_TRIGGER_ENABLED=false
APPLICATION_SAFETY_ATS_MIN_SCORE=60
APPLICATION_SAFETY_GAP_MAX_SCORE=60
APPLICATION_SAFETY_BLACKLIST_COMPANIES=
APPLICATION_RETRY_MAX_ATTEMPTS=3
APPLICATION_RETRY_BASE_BACKOFF_MS=1000
# Real Playwright browser automation (guest/no-login apply flows only — never
# stores credentials, never bypasses CAPTCHA/login walls). guest-apply-only
# is a hard-coded safety default; do not flip it off in production.
BROWSER_AUTOMATION_ENABLED=false
BROWSER_AUTOMATION_GUEST_APPLY_ONLY=true
BROWSER_AUTOMATION_EXECUTOR_CORE_POOL_SIZE=1
BROWSER_AUTOMATION_EXECUTOR_MAX_POOL_SIZE=2
BROWSER_AUTOMATION_EXECUTOR_QUEUE_CAPACITY=20
ATS_CONNECTOR_ENABLED=false
ATS_CONNECTOR_EXECUTOR_CORE_POOL_SIZE=2
ATS_CONNECTOR_EXECUTOR_MAX_POOL_SIZE=4
ATS_CONNECTOR_EXECUTOR_QUEUE_CAPACITY=50

