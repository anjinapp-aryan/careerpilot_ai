# docker-compose.yml injects this entire file into the backend/agent-service
# containers via `env_file:`, so the canonical MINIO_*/SPRING_DATASOURCE_*/
# REDIS_URL/DATABASE_URL_PY names above are the only names that matter. See
# DEPLOYMENT_ORACLE_CLOUD.md.
# =============================================================================


