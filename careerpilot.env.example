# =============================================================================
# EXCLUDED — genuinely not needed here:
#   JAVA_OPTS           -> docker-compose.yml's backend service has its own
#                           compose-level default (`${JAVA_OPTS:-...}`); only add
#                           this var here if you need to override that default.
#
# docker-compose.yml injects this entire file into the backend/agent-service
# containers via `env_file:`, so the canonical MINIO_*/SPRING_DATASOURCE_*/
# REDIS_URL/DATABASE_URL_PY names above are the only names that matter. See
# DEPLOYMENT_ORACLE_CLOUD.md.
# =============================================================================


# ---- Manual additions (not part of the generated template above) ----
SPRING_PROFILES_ACTIVE=prod
MANAGEMENT_HEALTH_REDIS_ENABLED=false

# ── Phase C — Candidate ATS Profile ────────────────────────────────────────────
# Backs phone, location, links, employment, education and work-authorisation with
# real columns (V81) and records per-field provenance. Off => FieldMappingService
# reports every Phase C field unmapped, exactly as it did before the phase.
# Only values whose recorded source is trusted (USER_ENTERED / RESUME_EXTRACTED /
# LINKEDIN_IMPORTED / HUMAN_CONFIRMED) are ever visible to automation; an
# AI_SUGGESTED value is stored for review and is never filled into a form.
CANDIDATE_ATS_PROFILE_ENABLED=false

# ── Phase D — Employer Question Intelligence ──────────────────────────────────
# Deduplicated employer question library + reusable, human-approved answers (V82).
# Off => nothing is observed, matched, stored or reused. An answer becomes usable
# by browser automation ONLY after an explicit human approval; an AI_SUGGESTED
# draft is stored for review and is never submitted.
EMPLOYER_QUESTION_INTELLIGENCE_ENABLED=false

# ── Phase F1/F2 — Multi-step form navigation ──────────────────────────────────
# One browser lease per page: fill -> screenshot -> approval bundle -> RELEASE
# lease -> wait for a human -> new lease -> replay approved pages -> next page.
# A human approves EVERY page; one approval authorises exactly one more page.
# Replay re-fills approved pages deterministically (no AI, approved answers only)
# and never clicks submit. OFF => single-page behaviour is byte-for-byte unchanged.
BROWSER_AUTOMATION_MULTI_STEP_ENABLED=false
BROWSER_AUTOMATION_MULTI_STEP_MAX_STEPS=10
BROWSER_AUTOMATION_MULTI_STEP_SETTLE_MS=1500
