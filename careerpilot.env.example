# ---- Phase 3B.1 Career-Relevant Domestic/International Job Feed + Soft Threshold Engine ----
CAREER_ORCHESTRATOR_ENABLED=false
CAREER_ORCHESTRATOR_CRON=0 30 2 * * *
CAREER_ORCHESTRATOR_MAX_PER_USER=25
CAREER_ORCHESTRATOR_EXECUTOR_CORE_POOL_SIZE=2
CAREER_ORCHESTRATOR_EXECUTOR_MAX_POOL_SIZE=4
CAREER_ORCHESTRATOR_EXECUTOR_QUEUE_CAPACITY=200
CAREER_RELEVANCE_ENABLED=false
CAREER_THRESHOLD_RECOMMENDED=85
CAREER_THRESHOLD_DOMESTIC=60
CAREER_THRESHOLD_INTERNATIONAL=60
CAREER_THRESHOLD_HIDDEN=60
CAREER_SOFT_THRESHOLDS_ENABLED=false
CAREER_DOMESTIC_FILTER_ENABLED=false
CAREER_INTERNATIONAL_FILTER_ENABLED=false
CAREER_EXPLAINABILITY_ENABLED=false

# ---- Company/job discovery sources feeding the career orchestrator (all keyless
#      unless noted; each is skipped automatically when disabled) ----
CAREER_DISCOVERY_ASHBY_ENABLED=false
CAREER_DISCOVERY_ASHBY_BASE_URL=https://api.ashbyhq.com
CAREER_DISCOVERY_ASHBY_ORGS=
CAREER_DISCOVERY_ASHBY_THROTTLE_MS=300
CAREER_DISCOVERY_SMARTRECRUITERS_ENABLED=false
CAREER_DISCOVERY_SMARTRECRUITERS_BASE_URL=https://api.smartrecruiters.com
CAREER_DISCOVERY_SMARTRECRUITERS_COMPANIES=
CAREER_DISCOVERY_SMARTRECRUITERS_THROTTLE_MS=300
CAREER_DISCOVERY_AI_DEV_JOBS_ENABLED=false
CAREER_DISCOVERY_AI_DEV_JOBS_BASE_URL=https://aidevboard.com
CAREER_DISCOVERY_AI_DEV_JOBS_LIMIT=50
# DevITjobs UK / GraphQL Jobs ship as honest inert stubs (no verified keyless
# public feed exists) — enabling these flags has no effect until a real
# endpoint is confirmed and wired.
CAREER_DISCOVERY_DEVITJOBS_ENABLED=false
CAREER_DISCOVERY_GRAPHQL_JOBS_ENABLED=false
# Greenhouse/Lever job-listing providers (jobdiscovery.provider.*, distinct
# from the company-discovery sources above).
CAREER_DISCOVERY_GREENHOUSE_ENABLED=false
CAREER_DISCOVERY_GREENHOUSE_BASE_URL=https://boards-api.greenhouse.io/v1
CAREER_DISCOVERY_GREENHOUSE_BOARDS=
CAREER_DISCOVERY_GREENHOUSE_THROTTLE_MS=300
CAREER_DISCOVERY_LEVER_ENABLED=false
CAREER_DISCOVERY_LEVER_BASE_URL=https://api.lever.co/v0
CAREER_DISCOVERY_LEVER_COMPANIES=
CAREER_DISCOVERY_LEVER_THROTTLE_MS=300

# ---- Enterprise ATS Connector Framework (Workday/Taleo/SuccessFactors) ----
CAREER_DISCOVERY_ENTERPRISE_ENABLED=false
CAREER_DISCOVERY_WORKDAY_ENABLED=false
CAREER_DISCOVERY_WORKDAY_COMPANIES=
CAREER_DISCOVERY_WORKDAY_LIMIT=50
CAREER_DISCOVERY_WORKDAY_THROTTLE_MS=300
CAREER_DISCOVERY_WORKDAY_DETAIL_FETCH_LIMIT=0
# Taleo/SuccessFactors ship as honest inert stubs — no verified universal
# keyless public API exists for either (Taleo's only unauthenticated surface
# is an unstructured sitemap; SuccessFactors requires per-tenant OAuth2).
CAREER_DISCOVERY_TALEO_ENABLED=false
CAREER_DISCOVERY_TALEO_COMPANIES=
CAREER_DISCOVERY_SUCCESSFACTORS_ENABLED=false
CAREER_DISCOVERY_SUCCESSFACTORS_COMPANIES=
CAREER_DISCOVERY_HEALTH_CIRCUIT_COOLDOWN_MS=300000

# ---- Gap A: Company Discovery Agent (weekly background probe of unknown
#      companies' ATS endpoints; writes PENDING_APPROVAL connector rows) ----
CAREER_DISCOVERY_COMPANY_AGENT_GREENHOUSE_BASE_URL=https://boards-api.greenhouse.io/v1
CAREER_DISCOVERY_COMPANY_AGENT_ASHBY_BASE_URL=https://api.ashbyhq.com
CAREER_DISCOVERY_COMPANY_AGENT_SMARTRECRUITERS_BASE_URL=https://api.smartrecruiters.com
CAREER_DISCOVERY_COMPANY_AGENT_CANDIDATES=
COMPANY_DISCOVERY_ENABLED=false
COMPANY_DISCOVERY_CRON=0 0 5 * * MON
COMPANY_DISCOVERY_HEALTH_CIRCUIT_COOLDOWN_MS=300000
COMPANY_RESEARCH_ENABLED=false
COMPANY_KNOWLEDGE_ENABLED=false

# ---- Gap C: Career roadmap persistence (parses LangGraph career_strategy
#      output into the CareerStrategy row instead of discarding it) ----
CAREER_ROADMAP_PERSISTENCE_ENABLED=false

# ---- Gap B: Offer Intelligence & Salary Negotiation (read-only, never
#      generates legal/financial advice) ----
OFFER_INTELLIGENCE_ENABLED=false

# ---- Data retention (Phase 3B prep) ----
RETENTION_ENABLED=false
RETENTION_CRON=0 30 3 * * *
RETENTION_WORKFLOW_DEAD_LETTER_DAYS=90
RETENTION_WORKFLOW_CORRELATION_DAYS=180
RETENTION_RECOMMENDATION_AUDIT_DAYS=365
RETENTION_EXECUTION_AUDIT_DAYS=365
RETENTION_RESUME_TAILORING_AUDIT_DAYS=365

# ---- Phase 7.15 STAR Story Intelligence & Behavioral AI ----
STORY_ENGINE_ENABLED=false
STORY_EXTRACTION_ENABLED=false
STORY_GENERATION_ENABLED=false
STORY_RECOMMENDATION_ENABLED=false
STORY_ANALYTICS_ENABLED=false
STORY_SEARCH_ENABLED=false
STORY_HISTORY_ENABLED=false
STORY_DIAGNOSTICS_ENABLED=false
STORY_WORKER_TRIGGER_ENABLED=false
STORY_EXECUTOR_CORE_POOL_SIZE=2
STORY_EXECUTOR_MAX_POOL_SIZE=4
STORY_EXECUTOR_QUEUE_CAPACITY=200


