APPLICATION_ANALYTICS_EXECUTOR_MAX_POOL_SIZE=2
APPLICATION_ANALYTICS_EXECUTOR_QUEUE_CAPACITY=100

# ---- Phase 7.16 Real Application Submission Pipeline ----
APPLICATION_SUBMISSION_ENABLED=false
APPLICATION_SUBMISSION_AUTO_ENABLED=false
