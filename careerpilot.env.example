WORKFLOW_TIMELINE_EXECUTOR_MAX_POOL_SIZE=4
WORKFLOW_TIMELINE_EXECUTOR_QUEUE_CAPACITY=100
APPLICATION_TRACKING_ENABLED=false
APPLICATION_TRACKING_TRIGGER_ENABLED=false
APPLICATION_TRACKING_EXECUTOR_CORE_POOL_SIZE=2
APPLICATION_TRACKING_EXECUTOR_MAX_POOL_SIZE=4
APPLICATION_TRACKING_EXECUTOR_QUEUE_CAPACITY=100
APPLICATION_ANALYTICS_ENABLED=false
APPLICATION_ANALYTICS_TRIGGER_ENABLED=false
